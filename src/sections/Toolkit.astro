---
/**
 * The scattered TOOLKIT word, then every tool used across the repos (src/data/toolkit.ts).
 *
 * As written this is a calm spec sheet, one wrapping row per group, which is what shows without
 * JS. src/motion/toolkit.ts turns it into the scroll moment: the stage pins,
 * the tools start scattered through 3D space and fly into six lanes as you scroll (a counter ticks
 * up as they land), then each lane drifts as a marquee that answers your scroll speed.
 */
import { copy } from '../data/copy'
import { toolkit } from '../data/toolkit'

const pad = (n: number) => String(n).padStart(2, '0')
const total = toolkit.reduce((sum, { tools }) => sum + tools.length, 0)

// Hover tints an icon in its brand colour, but only where that colour reads on the silver page.
const luminance = (hex: string) => {
  const [r, g, b] = [0, 2, 4].map((i) => {
    const c = parseInt(hex.slice(i, i + 2), 16) / 255
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4
  })
  return 0.2126 * r + 0.7152 * g + 0.0722 * b
}
const SILVER = luminance('e2e1e1')
const readable = (hex: string) => (SILVER + 0.05) / (luminance(hex) + 0.05) >= 2.6
---

<section class="toolkit" data-theme="dark" aria-labelledby="toolkit-title">
  <h2 class="toolkit__big" id="toolkit-title" data-split-random>{copy.toolkit.big}</h2>
  <div class="toolkit__stage" data-toolkit>
    <p class="toolkit__text">
      {copy.toolkit.text} <span class="toolkit__total">[ <span data-toolkit-count>{total}</span> ]</span>
    </p>
    <div class="toolkit__sheet" data-toolkit-sheet>
      {
        toolkit.map(({ group, tools }) => (
          <div class="toolkit__group" data-toolkit-lane>
            <h3 class="toolkit__name" data-toolkit-name>
              {group}
              <span class="toolkit__count">[{pad(tools.length)}]</span>
            </h3>
            <div class="toolkit__window" data-toolkit-window>
              <ul class="toolkit__list" data-toolkit-track>
                {tools.map(({ label, icon, mark }) => (
                  <li
                    class="toolkit__tool"
                    data-toolkit-chip
                    style={icon && readable(icon.hex) ? `--brand: #${icon.hex}` : undefined}
                  >
                    {icon ? (
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d={icon.path} />
                      </svg>
                    ) : (
                      <span class="toolkit__mark" aria-hidden="true">
                        {mark}
                      </span>
                    )}
                    <span>{label}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .toolkit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3em;
    width: 100%;
    padding: 7.5em 2em;
  }
  .toolkit__big {
    font-size: 7.3em;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
  }
  .toolkit__stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5em;
    width: 100%;
  }
  .toolkit__text {
    max-width: 40em;
    text-align: center;
  }
  .toolkit__total {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    opacity: 0.5;
  }

  /* The sheet: one ruled row per group, the name on the left and its tools on the right. */
  .toolkit__sheet {
    width: 100%;
    max-width: 76em;
    border-bottom: 1px solid rgb(8 9 18 / 0.14);
  }
  .toolkit__group {
    display: grid;
    grid-template-columns: 15em minmax(0, 1fr);
    align-items: center;
    gap: 1.5em;
    padding: 1.1em 0;
    border-top: 1px solid rgb(8 9 18 / 0.14);
  }
  .toolkit__name {
    font-size: 0.9em;
    font-weight: 650;
    line-height: 1.6;
    text-transform: uppercase;
  }
  .toolkit__count {
    margin-left: 0.5em;
    font-weight: 400;
    opacity: 0.45;
  }
  .toolkit__window {
    position: relative;
    min-width: 0;
  }
  .toolkit__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
    padding: 0;
    list-style: none;
  }
  .toolkit__tool {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    padding: 0.5em 1em 0.5em 0.75em;
    border: 1px solid rgb(8 9 18 / 0.14);
    border-radius: 2em;
    background: rgb(255 255 255 / 0.3);
    font-size: 0.95em;
    line-height: 1.3;
    white-space: nowrap;
    transition:
      border-color 0.25s,
      background-color 0.25s;
  }
  .toolkit__tool svg {
    flex: none;
    width: 1.25em;
    height: 1.25em;
    fill: currentColor;
    transition: fill 0.25s;
  }
  .toolkit__tool:hover {
    border-color: rgb(8 9 18 / 0.32);
    background: rgb(255 255 255 / 0.6);
  }
  .toolkit__tool:hover svg {
    fill: var(--brand, currentColor);
  }
  /* For tools Simple Icons doesn't cover: a two-letter mark the same size as a logo. */
  .toolkit__mark {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 2.1em;
    height: 2.1em;
    border: 1px solid currentColor;
    border-radius: 0.35em;
    font-size: 0.6em;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  /* Lanes (src/motion/toolkit.ts): each group is one line that drifts sideways. */
  .toolkit__stage.is-lanes {
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: 5em 0 2em;
  }
  .is-lanes .toolkit__sheet {
    perspective: 1100px;
  }
  .is-lanes .toolkit__group,
  .is-lanes .toolkit__window {
    transform-style: preserve-3d;
  }
  .is-lanes .toolkit__list {
    flex-wrap: nowrap;
    width: max-content;
    /* Starts the first tool clear of the left edge fade. */
    padding-left: 3em;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .is-lanes .toolkit__tool {
    will-change: transform, opacity;
  }
  /* Once everything has landed, each lane clips to its window, with soft edges. */
  .is-lanes.is-sorted .toolkit__window {
    overflow: hidden;
  }
  .is-lanes .toolkit__window::before,
  .is-lanes .toolkit__window::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 1;
    width: 4em;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s;
  }
  .is-lanes .toolkit__window::before {
    left: 0;
    background: linear-gradient(90deg, var(--c-silver), rgb(226 225 225 / 0));
  }
  .is-lanes .toolkit__window::after {
    right: 0;
    background: linear-gradient(270deg, var(--c-silver), rgb(226 225 225 / 0));
  }
  .is-lanes.is-sorted .toolkit__window::before,
  .is-lanes.is-sorted .toolkit__window::after {
    opacity: 1;
  }

  @media (max-width: 991px) {
    .toolkit {
      gap: 2.25em;
      padding: 5.625em 1.5em;
    }
    .toolkit__big {
      font-size: 5em;
    }
    .toolkit__group {
      grid-template-columns: 10em minmax(0, 1fr);
      gap: 1em;
    }
  }
  @media (max-width: 767px) {
    .toolkit {
      padding: 4.5em 1em;
    }
    .toolkit__big {
      font-size: 3.35em;
    }
    .toolkit__stage {
      gap: 1.75em;
    }
    .toolkit__group {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.6em;
      padding: 0.9em 0;
    }
    .toolkit__tool {
      font-size: 0.85em;
    }
    .is-lanes .toolkit__window::before,
    .is-lanes .toolkit__window::after {
      width: 1.75em;
    }
    .is-lanes .toolkit__list {
      padding-left: 1.75em;
    }
  }
</style>
