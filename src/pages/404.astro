---
/**
 * GitHub Pages serves this for any path that doesn't exist. Same world as the home page: silver,
 * a pencil scribble drawing itself in behind, the wordmark as the way home.
 */
import BracketHeading from '../components/BracketHeading.astro'
import Button from '../components/Button.astro'
import Wordmark from '../components/Wordmark.astro'
import Base from '../layouts/Base.astro'
import { site } from '../data/site'
import { screenScribble } from '../lib/scribble'

const path = screenScribble({ seed: 21 })
---

<Base title={`Page not found · ${site.name}`} noindex intro={false}>
  <main class="lost">
    <div class="lost__scribble" aria-hidden="true">
      <svg viewBox="0 0 3200 3100" preserveAspectRatio="none" focusable="false">
        <path d={path} pathLength="1"></path>
      </svg>
    </div>
    <a class="lost__brand" href="/" aria-label={`${site.name}, home`}>
      <Wordmark decorative />
    </a>
    <div class="lost__body">
      <p class="lost__code" aria-hidden="true">404</p>
      <BracketHeading tag="h1" class="lost__heading">Page not found</BracketHeading>
      <p class="lost__text">The link may be old or mistyped. Everything I've built is on the home page.</p>
      <Button href="/" variant="blue">Back home</Button>
    </div>
  </main>
  <script>
    import { initButtons } from '../motion/buttons'
    initButtons()
  </script>
</Base>

<style is:global>
  .lost {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 7em 2em 4em;
    overflow: clip;
  }
  .lost__scribble {
    position: absolute;
    inset: 0;
    color: var(--accent);
    pointer-events: none;
  }
  .lost__scribble svg {
    width: 100%;
    max-width: none;
    height: 100%;
  }
  .lost__scribble path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.25;
    vector-effect: non-scaling-stroke;
    animation: lost-draw 2.6s cubic-bezier(0.625, 0.05, 0, 1) 0.2s forwards;
  }
  @keyframes lost-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .lost__brand {
    position: absolute;
    top: 1.5em;
    left: 2em;
    width: 16em;
    color: var(--fg);
  }
  .lost__body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5em;
    max-width: 34em;
    text-align: center;
  }
  .lost__code {
    font-size: 16em;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 0.82;
    letter-spacing: -0.03em;
    color: var(--accent-text);
  }
  .lost__heading {
    font-size: 2.5em;
  }
  /* The brackets slide in once, as they do on the home page when a heading scrolls into view. */
  .lost__heading .bracket-h__b {
    animation: lost-bracket 1.2s var(--ease-house) 0.3s both;
  }
  .lost__heading .bracket-h__b.is-left {
    --from: -160%;
  }
  .lost__heading .bracket-h__b.is-right {
    --from: 160%;
  }
  @keyframes lost-bracket {
    from {
      translate: var(--from) 0;
    }
  }
  .lost__text {
    max-width: 30em;
  }
  @media (max-width: 767px) {
    .lost {
      padding: 6em 1em 3em;
    }
    .lost__brand {
      left: 1em;
      width: 12em;
    }
    .lost__code {
      font-size: 9em;
    }
    .lost__heading {
      font-size: 2em;
    }
  }
</style>
