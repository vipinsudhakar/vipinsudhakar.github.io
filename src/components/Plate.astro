---
/** A styled stand-in for a missing image: a loose scribble on deep blue with a small caption. */
import { looseScribble } from '../lib/scribble'

interface Props {
  label: string
  seed?: number
  class?: string
}
const { label, seed = 5, class: className } = Astro.props
const path = looseScribble({ seed })
---

<div class:list={['plate', className]} role="img" aria-label={label}>
  <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <path d={path}></path>
  </svg>
  <span class="plate__label" aria-hidden="true">{label}</span>
</div>

<style is:global>
  .plate {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--accent-deep);
    color: var(--on-accent);
  }
  .plate svg {
    position: absolute;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
  }
  .plate path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.35;
    vector-effect: non-scaling-stroke;
  }
  .plate__label {
    position: absolute;
    left: 1em;
    bottom: 0.9em;
    font-size: 0.85em;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
</style>
