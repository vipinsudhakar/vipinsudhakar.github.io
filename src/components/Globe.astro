---
/** A small line-drawn globe that spins, made only of CSS. Purely decorative. */
---

<span class="globe" aria-hidden="true">
  <span class="globe__ball">
    <span class="globe__meridian"></span>
    <span class="globe__meridian"></span>
    <span class="globe__meridian"></span>
    <span class="globe__latitude"></span>
    <span class="globe__equator"></span>
  </span>
</span>

<style is:global>
  .globe {
    position: relative;
    flex: none;
    width: 3em;
    height: 3em;
  }
  .globe__ball {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: inset 0 0 0 0.125em currentColor;
    animation: globe-tilt 10.8s cubic-bezier(0.35, 0, 0.65, 1) infinite;
  }
  /* A meridian is an ellipse whose visible edge sweeps across the ball: a crescent on the left,
     a straight line in the middle, a crescent on the right. Three run a third of a turn apart. */
  .globe__meridian {
    position: absolute;
    top: 0;
    left: 50%;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    translate: -50% 0;
    animation: globe-meridian 5.4s linear infinite;
  }
  .globe__meridian:nth-child(2) {
    animation-delay: -1.8s;
  }
  .globe__meridian:nth-child(3) {
    animation-delay: -3.6s;
  }
  .globe__latitude {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 150%;
    height: 55%;
    border-radius: 50%;
    translate: -50% -50%;
    box-shadow: inset 0 0 0 0.1em currentColor;
  }
  .globe__equator {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 0.11em;
    translate: 0 -50%;
    background: currentColor;
  }
  @keyframes globe-tilt {
    from {
      rotate: 0deg;
    }
    to {
      rotate: 360deg;
    }
  }
  @keyframes globe-meridian {
    0% {
      width: 100%;
      box-shadow: inset 0.075em 0 0 0.06em currentColor;
    }
    49.9% {
      width: 0.12em;
      box-shadow: inset 0.075em 0 0 0.06em currentColor;
      border-radius: 50%;
    }
    50% {
      width: 0.12em;
      border-radius: 0;
      box-shadow: inset 0 0 0 0.06em currentColor;
    }
    50.1% {
      width: 0.12em;
      border-radius: 50%;
      box-shadow: inset -0.075em 0 0 0.06em currentColor;
    }
    100% {
      width: 100%;
      box-shadow: inset -0.075em 0 0 0.06em currentColor;
    }
  }
</style>
