---
/**
 * The fixed header. The wordmark starts as a full-width masthead over the hero and shrinks into
 * the corner as you scroll past it (src/motion/logo-scroll.ts), then works as a back-to-top link.
 * The header's colour follows the section underneath it (src/motion/theme-nav.ts).
 */
import Button from './Button.astro'
import Wordmark from './Wordmark.astro'

interface Props {
  /** On pages other than home: the wordmark sits compact in the corner and links home. */
  page?: boolean
}
const { page = false } = Astro.props
const contactHref = page ? '/#contact' : '#contact'
---

<header class="header" data-header>
  <div class="header__inner">
    <div class="header__brand-wrap">
      <a
        class:list={['brand', { 'is-page': page }]}
        href={page ? '/' : '#top'}
        data-brand
        data-anchor={page ? undefined : ''}
        aria-label={page ? 'Vipin Sudhakar, home' : 'Vipin Sudhakar, back to top'}
      >
        <Wordmark decorative />
      </a>
    </div>
    <button class="scheme" type="button" data-scheme-toggle aria-label="Night theme" aria-pressed="false">
      <svg class="scheme__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="8.5"></circle>
        <path d="M12 3.5a8.5 8.5 0 0 1 0 17z"></path>
      </svg>
    </button>
    <nav class="header__cta" aria-label="Get in touch">
      <Button href={contactHref} contact="email" variant="ink">Email me</Button>
      <Button href={contactHref} contact="whatsapp" variant="blue" external>WhatsApp</Button>
    </nav>
  </div>
</header>

<div class="blur-strip" aria-hidden="true">
  <div></div><div></div><div></div><div></div><div></div>
</div>

<style is:global>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 99;
    padding: 1em 2em;
    color: var(--fg);
    transition: color 0.2s;
    pointer-events: none;
  }
  [data-nav-theme='light'] .header {
    color: var(--on-accent);
  }
  .header__inner {
    position: relative;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1em;
    max-width: calc(var(--scale-max) - 4em);
    margin-inline: auto;
  }
  .header__brand-wrap {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  /* --p runs from 0 (full-width masthead) to 1 (compact logo in the corner). --brand-y drops the
     masthead below the buttons, as a share of its own height. */
  .brand {
    --p: 0;
    --brand-w: 16em;
    --brand-y: 112%;
    position: absolute;
    left: 0;
    width: calc(var(--brand-w) + (100% - var(--brand-w)) * (1 - var(--p)));
    translate: 0 calc(var(--brand-y) * (1 - var(--p)));
    pointer-events: none;
  }
  .brand.is-compact {
    pointer-events: auto;
  }
  .brand.is-hidden {
    opacity: 0;
    pointer-events: none;
  }
  .no-js .brand,
  .brand.is-page {
    --p: 1;
    pointer-events: auto;
  }

  .header__cta {
    display: flex;
    gap: 1em;
    pointer-events: auto;
  }

  /* Day or night (src/motion/scheme.ts). The half-filled circle turns over with the theme. */
  .scheme {
    display: grid;
    place-items: center;
    width: 2.5em;
    height: 2.5em;
    border: 1px solid currentColor;
    border-radius: 50%;
    pointer-events: auto;
    transition:
      background-color 0.25s,
      scale 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .no-js .scheme {
    display: none;
  }
  .scheme:hover {
    background: color-mix(in srgb, currentColor 12%, transparent);
  }
  .scheme:active {
    scale: 0.92;
  }
  .scheme__icon {
    width: 1.15em;
    height: 1.15em;
    transition: rotate 0.8s var(--ease-house);
  }
  .scheme__icon circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }
  .scheme__icon path {
    fill: currentColor;
  }
  :root[data-scheme='night'] .scheme__icon {
    rotate: 180deg;
  }
  /* Over blue and black sections the pills turn light, or they would vanish into the background. */
  [data-nav-theme='light'] .header .btn {
    --btn-fg: var(--c-ink);
    --btn-bg: var(--on-accent);
  }
  [data-nav-theme='light'] .header .btn[data-variant='blue'] {
    --btn-fg: var(--accent);
    --btn-bg: var(--c-white);
  }

  /* Five stacked layers of backdrop blur, strongest at the very top, so content scrolling under
     the header softens instead of being cut off by a hard edge. */
  .blur-strip {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 98;
    width: 100%;
    height: 8em;
    pointer-events: none;
  }
  .blur-strip > div {
    position: absolute;
    inset: 0;
  }
  .blur-strip > :nth-child(1) {
    backdrop-filter: blur(0.02em);
    mask: linear-gradient(#000 0 50%, #0000 87.5%);
  }
  .blur-strip > :nth-child(2) {
    backdrop-filter: blur(0.04em);
    mask: linear-gradient(#000 0 37.5%, #0000 75%);
  }
  .blur-strip > :nth-child(3) {
    backdrop-filter: blur(0.08em);
    mask: linear-gradient(#000 0 25%, #0000 62.5%);
  }
  .blur-strip > :nth-child(4) {
    backdrop-filter: blur(0.14em);
    mask: linear-gradient(#000 0 12.5%, #0000 50%);
  }
  .blur-strip > :nth-child(5) {
    backdrop-filter: blur(0.22em);
    mask: linear-gradient(#000 0 0%, #0000 37.5%);
  }

  @media (max-width: 991px) {
    .header {
      padding: 0.75em 1.5em;
    }
    .brand {
      --brand-w: 12em;
      --brand-y: 130%;
    }
    .header__inner,
    .header__cta {
      gap: 0.75em;
    }
    .scheme {
      font-size: 0.875em;
    }
    .blur-strip {
      height: 6em;
    }
  }
  @media (max-width: 767px) {
    .header {
      padding: 1em;
    }
    .brand {
      --brand-w: 9em;
      --brand-y: 140%;
    }
    .header__inner,
    .header__cta {
      gap: 0.5em;
    }
  }
  /* Small phones: a slightly smaller corner wordmark and controls, so the theme toggle and both
     pills fit beside the name. */
  @media (max-width: 479px) {
    .brand {
      --brand-w: 7.25em;
      --brand-y: 180%;
    }
    .header__cta .btn,
    .scheme {
      font-size: 0.8em;
    }
  }
</style>
