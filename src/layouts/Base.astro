---
import '@fontsource-variable/archivo'
import archivo from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url'
import '../styles/tokens.css'
import '../styles/global.css'
import { expertise } from '../data/expertise'
import { site } from '../data/site'

interface Props {
  /** The tab title; the home page uses site.title. */
  title?: string
  /** Keeps the page out of search results (the 404 page). */
  noindex?: boolean
  /** The page has the loader and intro (Intro.astro), so scrolling starts locked until they finish. */
  intro?: boolean
}
const { title = site.title, noindex = false, intro = true } = Astro.props

const { email, phone, linkedin, github } = site.contact
const canonical = new URL(Astro.url.pathname, site.url).href
const ogImage = new URL('/og.png', site.url).href

// The browser decodes this to fill in the contact links (src/motion/contact.ts).
const contactKey = btoa(
  JSON.stringify({
    e: email.join('@'),
    p: phone.join(''),
    d: `+${phone[0]} ${phone.slice(1).join(' ')}`,
  }),
)

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  description: site.description,
  jobTitle: 'Software developer',
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: `${site.education.school}, ${site.education.campus}`,
  },
  knowsAbout: expertise.map((area) => area.title),
  sameAs: [github, linkedin].filter(Boolean),
}
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js')
      history.scrollRestoration = 'manual'
    </script>
    {
      intro && (
        <script is:inline>
          // Locks scrolling until the intro has played (see global.css and motion/intro.ts).
          document.documentElement.classList.add('is-loading')
        </script>
      )
    }
    <title>{title}</title>
    <meta name="description" content={site.description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#e2e1e1" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body data-nav-theme="dark" data-k={contactKey}>
    <slot />
  </body>
</html>
